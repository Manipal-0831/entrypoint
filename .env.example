# Copy this file to .env for local development (never commit the real .env).

SECRET_KEY=change-this-to-a-long-random-string

# Leave unset to use local SQLite (entrypoint.db). For MySQL (used in production):
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>
DATABASE_URL=sqlite:///example.db(for local test we use )

